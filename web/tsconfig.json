{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true, "types": ["vite/client"],
    "skipLibCheck": true, "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts", "tests/e2e"]
}
